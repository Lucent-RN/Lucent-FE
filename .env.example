# Same Supabase project as the mobile apps (copy from LucentMeet/.env: EXPO_PUBLIC_* -> NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=
# The Google *web* OAuth client (same value as EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID).
# Add  <your site>/api/meet/google/callback  to its "Authorized redirect URIs" in Google Cloud.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
